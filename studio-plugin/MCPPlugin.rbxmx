	_object_1[_left_5] = _result_5
	local item = _object_1
	table.insert(activityItems, 1, item)
	if arrayCount(activityItems) > MAX_ACTIVITY_ITEMS then
		activityItems[#activityItems] = nil
	end
	return item
end
local function getActivity()
	return activityItems
end
local function clearActivity()
	table.clear(activityItems)
end
return {
	CURRENT_VERSION = CURRENT_VERSION,
	MAX_CONNECTIONS = MAX_CONNECTIONS,
	BASE_PORT = BASE_PORT,
	MAX_ACTIVITY_ITEMS = MAX_ACTIVITY_ITEMS,
	connections = connections,
	addConnection = addConnection,
