	local function buildTree(instance, depth)
		if depth > 10 then
			return {
				name = instance.Name,
				className = instance.ClassName,
				children = {},
			}
		end
		local node = {
			name = instance.Name,
			className = instance.ClassName,
			path = getInstancePath(instance),
