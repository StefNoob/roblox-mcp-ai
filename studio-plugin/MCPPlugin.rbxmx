	setmetatable(_object_1, nil)
	return _object_1
end
local function addActivity(level, category, title, detail, options)
	activityCounter += 1
	local _object_1 = {
		id = activityCounter,
		timestamp = tick(),
		level = level,
		category = category,
		title = title,
		detail = detail,
	}
	local _left = "endpoint"
	local _result = options
	if _result ~= nil then
		_result = _result.endpoint
	end
