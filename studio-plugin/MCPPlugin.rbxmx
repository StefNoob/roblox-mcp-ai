          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local function getActivationOptions(source)
	return {
		showUi = source == "manual",
		sendImmediatePing = true,
		bootstrapRetryCount = if source == "startup" then 5 else 2,
		bootstrapRetryDelaySeconds = if source == "startup" then 1 else 0.5,
	}
end
return {
	getActivationOptions = getActivationOptions,
}
]]></string>
