          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(script.Parent.Parent.include.RuntimeLib)
local RunService = TS.import(script, script.Parent.Parent, "node_modules", "@rbxts", "services").RunService
local _WriteSafetyRules = TS.import(script, script.Parent, "WriteSafetyRules")
local describeWriteBlockReason = _WriteSafetyRules.describeWriteBlockReason
local shouldBlockWrite = _WriteSafetyRules.shouldBlockWrite
local function getStudioWriteState()
	local isRunning = false
	local isEdit = false
	TS.try(function()
		isRunning = RunService:IsRunning() == true
	end, function()
		isRunning = false
	end)
	TS.try(function()
		isEdit = RunService:IsEdit() == true
	end, function()
		isEdit = false
	end)
	if isRunning and isEdit then
		isEdit = false
	end
	if isRunning then
		isRunning = true
	end
	return {
		isRunning = isRunning,
		isEdit = isEdit,
	}
end
return {
	getStudioWriteState = getStudioWriteState,
	describeWriteBlockReason = describeWriteBlockReason,
	shouldBlockWrite = shouldBlockWrite,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">WriteSafetyRules</string>
          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local function shouldBlockWrite(state)
	return state.isRunning and not state.isEdit
end
local function describeWriteBlockReason(state)
	if not shouldBlockWrite(state) then
		return nil
	end
	return "Write operations are blocked while Roblox Studio is in Play/Run mode. Stop the session and retry so changes apply to the edit-place instead of the runtime copy."
end
return {
	shouldBlockWrite = shouldBlockWrite,
	describeWriteBlockReason = describeWriteBlockReason,
}
]]></string>
