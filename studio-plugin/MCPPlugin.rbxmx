          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(script.Parent.Parent.include.RuntimeLib)
local HttpService = TS.import(script, script.Parent.Parent, "node_modules", "@rbxts", "services").HttpService
local function defaultFallbackClock()
	return `{tostring(math.floor(tick() * 1000))}-{tostring(math.random(0, 999999))}`
end
local function defaultGuidGenerator()
	local _exitType, _returns = TS.try(function()
		return TS.TRY_RETURN, { HttpService:GenerateGUID(false) }
	end, function()
		return TS.TRY_RETURN, { nil }
	end)
	if _exitType then
		return unpack(_returns)
	end
end
local function createPluginSessionId(generateGuid, fallbackClock)
	if generateGuid == nil then
		generateGuid = defaultGuidGenerator
	end
	if fallbackClock == nil then
		fallbackClock = defaultFallbackClock
	end
	local guid = generateGuid()
	local _condition = guid
	if _condition ~= "" and _condition then
		_condition = guid ~= ""
	end
	if _condition ~= "" and _condition then
		return `studio-{guid}`
	end
	return `studio-fallback-{fallbackClock()}`
end
return {
	createPluginSessionId = createPluginSessionId,
}
