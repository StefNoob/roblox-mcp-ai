          <string name="Name">PollResult</string>
          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local function isSuccessfulStatusCode(statusCode, allowSoftWaitingStatus)
	if allowSoftWaitingStatus == nil then
		allowSoftWaitingStatus = false
	end
	return (statusCode >= 200 and statusCode < 300) or statusCode == 304 or (allowSoftWaitingStatus and statusCode == 503)
end
local function isPollHttpSuccess(result)
	if result.Success == true then
		return true
	end
	local statusCode = result.StatusCode
	if typeOf(statusCode) == "number" then
		local numericStatusCode = statusCode
		return isSuccessfulStatusCode(numericStatusCode, true)
	end
	return false
end
local function isHandshakeHttpSuccess(result)
	if result.Success == true then
		return true
	end
	local statusCode = result.StatusCode
	if typeOf(statusCode) == "number" then
		return isSuccessfulStatusCode(statusCode, false)
	end
	return false
end
local function describePollFailure(success, result)
	if not success then
		return `transport error: {result}`
	end
	if result ~= nil and typeOf(result) == "table" then
		local pollResult = result
		local statusCode = pollResult.StatusCode
		local statusMessage = pollResult.StatusMessage
		if typeOf(statusCode) == "number" then
			if typeOf(statusMessage) == "string" and statusMessage ~= "" then
				return `http {statusCode} {statusMessage}`
			end
			return `http {statusCode}`
		end
	end
	return "unknown polling failure"
end
return {
	isPollHttpSuccess = isPollHttpSuccess,
	isHandshakeHttpSuccess = isHandshakeHttpSuccess,
	describePollFailure = describePollFailure,
}
]]></string>
