local function extractPathFromRequestData(data)
	local candidates = { data.instancePath, data.path, data.parent, data.rootPath }
	for _, candidate in candidates do
		if type(candidate) == "string" and #candidate > 0 then
			return candidate
		end
	end
	return nil
end
local function buildRetryContext(endpoint, data)
	return {
		endpoint = endpoint,
		path = extractPathFromRequestData(data),
		payload = data,
	}
end
local function updateDiagnosticsFromServer(conn)
	local now = tick()
	if now - lastDiagnosticsPollAt < 2 then
		return nil
	end
	lastDiagnosticsPollAt = now
	task.spawn(function()
		local ok, result = pcall(function()
			return HttpService:RequestAsync({
				Url = `{conn.serverUrl}/diagnostics`,
				Method = "GET",
				Headers = {
					["Content-Type"] = "application/json",
				},
			})
		end)
		if not ok or not result.Success then
			UI.updateDiagnosticsPanel({
				serverReachable = false,
				serverMessage = "diagnostics endpoint unreachable",
				bridgeStatus = "unreachable",
				pluginStatus = "unreachable",
				mcpStatus = "unreachable",
				endpointSupport = "unknown",
				cacheStatus = "unknown",
				writeQueueStatus = "unknown",
				lastErrorSummary = "none",
				lastErrorCause = "Cannot reach /diagnostics endpoint from plugin.",
				lastUpdatedAtText = "n/a",
			})
			return nil
		end
		local decodedOk, decoded = pcall(function()
			return HttpService:JSONDecode(result.Body)
		end)
		if not decodedOk then
			UI.updateDiagnosticsPanel({
				serverReachable = false,
				serverMessage = "invalid diagnostics payload",
				bridgeStatus = "invalid payload",
				pluginStatus = "invalid payload",
				mcpStatus = "invalid payload",
				endpointSupport = "unknown",
				cacheStatus = "unknown",
				writeQueueStatus = "unknown",
				lastErrorSummary = "invalid diagnostics response",
				lastErrorCause = "Server diagnostics JSON decode failed.",
				lastUpdatedAtText = "n/a",
			})
			return nil
		end
		local diagnostics = decoded
		local _result = diagnostics.plugin
		if _result ~= nil then
			_result = _result.capabilities
		end
		local _condition = _result
		if _condition == nil then
			_condition = {}
		end
		local pluginCaps = _condition
		local serverCaps = diagnostics.serverCapabilities or {}
		local _result_1 = diagnostics.writeQueue
		if _result_1 ~= nil then
			_result_1 = _result_1.inFlight
		end
		local inFlight = if _result_1 ~= 0 and _result_1 == _result_1 and _result_1 ~= "" and _result_1 then "active" else "idle"
		local _result_2 = diagnostics.writeQueue
		if _result_2 ~= nil then
			_result_2 = _result_2.pending
		end
		local _condition_1 = _result_2
		if _condition_1 == nil then
			_condition_1 = 0
		end
		local pending = _condition_1
		local latestError = if diagnostics.recentErrors and arrayCount(diagnostics.recentErrors) > 0 then diagnostics.recentErrors[arrayCount(diagnostics.recentErrors)] else nil
		local _result_3 = latestError
		if _result_3 ~= nil then
			_result_3 = _result_3.message
		end
		local _condition_2 = _result_3
		if _condition_2 == nil then
			_condition_2 = "none"
		end
		local lastErrorSummary = _condition_2
		local _cache = diagnostics.runtime
		if _cache ~= nil then
			_cache = _cache.structureMap
			if _cache ~= nil then
				_cache = _cache.cache
			end
		end
		local cache = _cache
		local _result_4
		if cache then
			local _exp = if cache.cached then "ready" else "empty"
			local _condition_3 = cache.summaryCount
			if _condition_3 == nil then
				_condition_3 = 0
			end
			local _exp_1 = tostring(_condition_3)
			local _condition_4 = cache.freshSummaryCount
			if _condition_4 == nil then
				_condition_4 = 0
			end
			local _exp_2 = tostring(_condition_4)
			local _condition_5 = cache.staleSummaryCount
			if _condition_5 == nil then
				_condition_5 = 0
			end
			local _exp_3 = tostring(_condition_5)
			local _condition_6 = cache.sourceCount
			if _condition_6 == nil then
				_condition_6 = 0
			end
			_result_4 = `structure:{_exp} summaries:{_exp_1} fresh:{_exp_2} stale:{_exp_3} source:{tostring(_condition_6)}`
		else
			_result_4 = "structure/source cache unavailable"
		end
		local cacheStatus = _result_4
		local _object = {
			serverReachable = true,
			serverMessage = "ok",
			bridgeStatus = if diagnostics.bridge then "online" else "unknown",
		}
		local _left = "pluginStatus"
		local _result_5 = diagnostics.plugin
		if _result_5 ~= nil then
			_result_5 = _result_5.connected
		end
		_object[_left] = if _result_5 then "connected" else "not connected"
		_object.mcpStatus = if diagnostics.mcpServerActive then "active" else "inactive"
		_object.endpointSupport = `fastWrite:{tostring(serverCaps.setScriptSourceFast == true)} ` .. `scriptMetadata:{tostring(pluginCaps.scriptMetadata == true or pluginCaps.scriptMetadataEndpoint == true)} ` .. `structureMap:{tostring(pluginCaps.useStructureMapping == true)}`
		_object.cacheStatus = cacheStatus
		_object.writeQueueStatus = `{inFlight} / pending:{pending}`
		_object.lastErrorSummary = lastErrorSummary
		_object.lastErrorCause = UI.inferProbableCause(lastErrorSummary)
		_object.lastUpdatedAtText = DateTime.fromUnixTimestamp(math.floor(now)):FormatLocalTime("HH:mm:ss", "en-us")
		UI.updateDiagnosticsPanel(_object)
	end)
end
local sendReadyHandshake, processRequest
local function retryFailedActivity(retryContext)
	local _value = retryContext.endpoint
	if not (_value ~= "" and _value) then
		log("warn", "Retry skipped", "Missing endpoint in retry context.")
		return nil
	end
	if retryContext.endpoint == "/ready" then
		local conn = State.getActiveConnection()
		if not conn then
			log("warn", "Retry skipped", "No active connection for ready handshake retry.")
			return nil
		end
		local handshakeOk = sendReadyHandshake(conn)
		if handshakeOk then
			log("success", "Retry completed", "Ready handshake sent.")
			updateDiagnosticsFromServer(conn)
		else
			log("error", "Retry failed", "Ready handshake failed again.", {
				endpoint = "/ready",
				error = "ready handshake failed",
				retryContext = retryContext,
			})
		end
		return nil
	end
	local request = {
		endpoint = retryContext.endpoint,
		data = (retryContext.payload) or {},
	}
	local ok, response = pcall(function()
		return processRequest(request)
	end)
	if not ok then
		log("error", "Retry failed", tostring(response), {
			endpoint = retryContext.endpoint,
			error = response,
			payload = retryContext.payload,
			path = retryContext.path,
			retryContext = retryContext,
		})
		return nil
	end
	if type(response) == "table" and response.error ~= nil then
		log("error", "Retry returned error", tostring(response.error), {
			endpoint = retryContext.endpoint,
			error = response.error,
			payload = retryContext.payload,
			path = retryContext.path,
			retryContext = retryContext,
		})
		return nil
	end
	log("success", "Retry completed", retryContext.endpoint, {
		endpoint = retryContext.endpoint,
		payload = retryContext.payload,
		path = retryContext.path,
	})
end
function processRequest(request)
	local endpoint = request.endpoint
	local data = request.data or {}
	if STRUCTURE_MAP_ENDPOINTS[endpoint] ~= nil and not isStructureMapEnabled() then
		return {
			error = "Structure map disabled in plugin settings",
		}
	end
	if WRITE_ENDPOINTS[endpoint] ~= nil then
		local writeState = getStudioWriteState()
		if shouldBlockWrite(writeState) then
			local _object = {}
			local _left = "error"
			local _condition = describeWriteBlockReason(writeState)
			if _condition == nil then
				_condition = "Write operation blocked."
			end
			_object[_left] = _condition
			_object.writeState = writeState
			return _object
		end
	end
	local handler = routeMap[endpoint]
	if handler then
		return handler(data)
	else
		return {
			error = `Unknown endpoint: {endpoint}`,
		}
	end
end
local function sendResponse(conn, requestId, responseData)
	local sessionId = State.getPluginSessionId()
	local ok, result = pcall(function()
		return HttpService:RequestAsync({
			Url = `{conn.serverUrl}/response`,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["x-mcp-session-id"] = sessionId,
			},
			Body = HttpService:JSONEncode({
				requestId = requestId,
				response = responseData,
			}),
		})
	end)
	return ok and result.Success == true
end
local function getConnectionStatus(connIndex)
	local conn = State.getConnection(connIndex)
	if not conn then
		return "disconnected"
	end
	return deriveConnectionPhase(conn)
end
local discoverPort
local function pollForRequests(connIndex)
	local conn = State.getConnection(connIndex)
	if not conn or not conn.isActive then
		return nil
	end
	if conn.isPolling then
		return nil
	end
	conn.isPolling = true
	local success, result = pcall(function()
		local sessionId = State.getPluginSessionId()
		local metadata = getStudioMetadata()
		return HttpService:RequestAsync({
			Url = `{conn.serverUrl}/poll?sid={HttpService:UrlEncode(sessionId)}` .. `&v={HttpService:UrlEncode(State.CURRENT_VERSION)}` .. `&placeId={HttpService:UrlEncode(tostring(metadata.placeId))}` .. `&placeName={HttpService:UrlEncode(metadata.placeName)}` .. `&gameId={HttpService:UrlEncode(tostring(metadata.gameId))}`,
			Method = "GET",
			Headers = {
				["Content-Type"] = "application/json",
				["x-mcp-session-id"] = sessionId,
				["x-mcp-plugin-version"] = State.CURRENT_VERSION,
				["x-mcp-plugin-capabilities"] = HttpService:JSONEncode(getPluginCapabilities()),
				["x-mcp-place-id"] = tostring(metadata.placeId),
				["x-mcp-place-name"] = metadata.placeName,
				["x-mcp-game-id"] = tostring(metadata.gameId),
			},
		})
	end)
	conn.isPolling = false
	local ui = UI.getElements()
	UI.updateTabDot(connIndex)
	UI.updateUIState()
	if success and isPollHttpSuccess(result) then
		local decodedOk, data = pcall(function()
			return HttpService:JSONDecode(result.Body)
		end)
		if not decodedOk then
			conn.consecutiveFailures += 1
			conn.lastHttpOk = false
			conn.lastMcpConnected = false
			log("error", "Polling payload invalid", "Server returned invalid JSON payload.", {
				error = data,
				retryContext = {
					endpoint = "/poll",
					payload = {
						serverUrl = conn.serverUrl,
						statusCode = result.StatusCode,
					},
				},
			})
			return nil
		end
		conn.consecutiveFailures = 0
		conn.currentRetryDelay = 0.5
		conn.lastSuccessfulConnection = tick()
		local pollData = data
		local mcpConnected = pollData.mcpConnected == true
		conn.lastHttpOk = true
		conn.lastMcpConnected = mcpConnected
		if connIndex == State.getActiveTabIndex() then
			local el = ui
			el.step1Dot.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
			el.step1Label.Text = "HTTP server (OK)"
			local _condition = mcpConnected
			if _condition then
				local _value = (string.find(el.statusLabel.Text, "Connected"))
				_condition = not (_value ~= 0 and _value == _value and _value)
			end
			if _condition then
				el.statusLabel.Text = "Connected"
				el.statusLabel.TextColor3 = Color3.fromRGB(34, 197, 94)
				el.statusIndicator.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
				el.statusPulse.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
				el.statusText.Text = "ONLINE"
				el.detailStatusLabel.Text = "HTTP: OK  MCP: OK"
				el.detailStatusLabel.TextColor3 = Color3.fromRGB(34, 197, 94)
				el.step2Dot.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
				el.step2Label.Text = "MCP bridge (OK)"
				el.step3Dot.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
				el.step3Label.Text = "Commands (OK)"
				conn.mcpWaitStartTime = nil
				el.troubleshootLabel.Visible = false
				UI.stopPulseAnimation()
				log("success", "MCP connected", `Connected on port {conn.port}`)
			elseif not mcpConnected then
				el.statusLabel.Text = "Waiting for MCP server"
				el.statusLabel.TextColor3 = Color3.fromRGB(245, 158, 11)
				el.statusIndicator.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.statusPulse.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.statusText.Text = "WAITING"
				el.detailStatusLabel.Text = "HTTP: OK  MCP: ..."
				el.detailStatusLabel.TextColor3 = Color3.fromRGB(245, 158, 11)
				el.step2Dot.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.step2Label.Text = "MCP bridge (waiting...)"
				el.step3Dot.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.step3Label.Text = "Commands (waiting...)"
				if conn.mcpWaitStartTime == nil then
					conn.mcpWaitStartTime = tick()
				end
				local _exp = tick()
				local _condition_1 = conn.mcpWaitStartTime
				if _condition_1 == nil then
					_condition_1 = tick()
				end
				local elapsed = _exp - _condition_1
				el.troubleshootLabel.Visible = elapsed > 8
				if elapsed > 3 and elapsed % 5 < conn.pollInterval then
					task.spawn(function()
						local discovered = discoverPort(conn)
						if discovered ~= nil and discovered ~= conn.port then
							conn.port = discovered
							conn.serverUrl = State.replaceConnectionPort(conn.serverUrl, discovered)
							if connIndex == State.getActiveTabIndex() then
								UI.getElements().urlInput.Text = conn.serverUrl
							end
						end
					end)
				end
				UI.startPulseAnimation()
			end
		end
		updateDiagnosticsFromServer(conn)
		if pollData.request and mcpConnected then
			local requestData = (pollData.request.data or {})
			local retryContext = buildRetryContext(pollData.request.endpoint, requestData)
			log("info", "MCP request received", pollData.request.endpoint, {
				endpoint = pollData.request.endpoint,
				payload = requestData,
				path = retryContext.path,
				retryContext = retryContext,
			})
			task.spawn(function()
				local ok, response = pcall(function()
					return processRequest(pollData.request)
				end)
				if ok then
					local responseSent = sendResponse(conn, pollData.requestId, response)
					local responseHasError = type(response) == "table" and response.error ~= nil
					if responseSent and not responseHasError then
						log("success", "MCP response sent", pollData.request.endpoint, {
							endpoint = pollData.request.endpoint,
							payload = requestData,
							path = retryContext.path,
						})
					elseif responseSent and responseHasError then
						log("error", "MCP action returned error", tostring(response.error), {
							endpoint = pollData.request.endpoint,
							error = response.error,
							payload = requestData,
							path = retryContext.path,
							retryContext = retryContext,
						})
					else
						log("error", "MCP response delivery failed", pollData.request.endpoint, {
							endpoint = pollData.request.endpoint,
							error = "response delivery failed",
							payload = requestData,
							path = retryContext.path,
						})
					end
				else
					local responseSent = sendResponse(conn, pollData.requestId, {
						error = tostring(response),
					})
					if not responseSent then
						log("error", "MCP error delivery failed", tostring(response), {
							endpoint = pollData.request.endpoint,
							error = response,
							payload = requestData,
							path = retryContext.path,
							retryContext = retryContext,
						})
					end
					log("error", "MCP handler error", tostring(response), {
						endpoint = pollData.request.endpoint,
						error = response,
						payload = requestData,
						path = retryContext.path,
						retryContext = retryContext,
					})
				end
			end)
		end
	elseif conn.isActive then
		local failureDetail = describePollFailure(success, result)
		conn.consecutiveFailures += 1
		conn.lastHttpOk = false
		conn.lastMcpConnected = false
		if conn.consecutiveFailures == 2 or conn.consecutiveFailures % 10 == 0 then
			log("warn", "Polling retry", `Attempt {conn.consecutiveFailures} on port {conn.port} ({failureDetail})`)
		end
		if conn.consecutiveFailures > 1 then
			conn.currentRetryDelay = math.min(conn.currentRetryDelay * conn.retryBackoffMultiplier, conn.maxRetryDelay)
		end
		if conn.consecutiveFailures == 5 or conn.consecutiveFailures % 20 == 0 then
			task.spawn(function()
				local discovered = discoverPort(conn)
				if discovered ~= nil and discovered ~= conn.port then
					conn.port = discovered
					conn.serverUrl = State.replaceConnectionPort(conn.serverUrl, discovered)
					conn.consecutiveFailures = 0
					conn.currentRetryDelay = 0.5
					if connIndex == State.getActiveTabIndex() then
						UI.getElements().urlInput.Text = conn.serverUrl
					end
				end
			end)
		end
		if connIndex == State.getActiveTabIndex() then
			local el = ui
			if conn.consecutiveFailures >= conn.maxFailuresBeforeError then
				el.statusLabel.Text = "Server unavailable"
				el.statusLabel.TextColor3 = Color3.fromRGB(239, 68, 68)
				el.statusIndicator.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
				el.statusPulse.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
				el.statusText.Text = "ERROR"
				el.detailStatusLabel.Text = "HTTP: X  MCP: X"
				el.detailStatusLabel.TextColor3 = Color3.fromRGB(239, 68, 68)
				el.step1Dot.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
				el.step1Label.Text = "HTTP server (error)"
				el.step2Dot.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
				el.step2Label.Text = "MCP bridge (error)"
				el.step3Dot.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
				el.step3Label.Text = "Commands (error)"
				conn.mcpWaitStartTime = nil
				el.troubleshootLabel.Visible = false
				UI.stopPulseAnimation()
			elseif conn.consecutiveFailures > 5 then
				local waitTime = math.ceil(conn.currentRetryDelay)
				el.statusLabel.Text = `Retrying ({waitTime}s)`
				el.statusLabel.TextColor3 = Color3.fromRGB(245, 158, 11)
				el.statusIndicator.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.statusPulse.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.statusText.Text = "RETRY"
				el.detailStatusLabel.Text = "HTTP: ...  MCP: ..."
				el.detailStatusLabel.TextColor3 = Color3.fromRGB(245, 158, 11)
				el.step1Dot.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.step1Label.Text = "HTTP server (retrying...)"
				el.step2Dot.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.step2Label.Text = "MCP bridge (retrying...)"
				el.step3Dot.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.step3Label.Text = "Commands (retrying...)"
				conn.mcpWaitStartTime = nil
				el.troubleshootLabel.Visible = false
				UI.startPulseAnimation()
			elseif conn.consecutiveFailures > 1 then
				el.statusLabel.Text = `Connecting (attempt {conn.consecutiveFailures})`
				el.statusLabel.TextColor3 = Color3.fromRGB(245, 158, 11)
				el.statusIndicator.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.statusPulse.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.statusText.Text = "CONNECTING"
				el.detailStatusLabel.Text = "HTTP: ...  MCP: ..."
				el.detailStatusLabel.TextColor3 = Color3.fromRGB(245, 158, 11)
				el.step1Dot.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.step1Label.Text = "HTTP server (connecting...)"
				el.step2Dot.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.step2Label.Text = "MCP bridge (connecting...)"
				el.step3Dot.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
				el.step3Label.Text = "Commands (connecting...)"
				conn.mcpWaitStartTime = nil
				el.troubleshootLabel.Visible = false
				UI.startPulseAnimation()
			end
		end
	end
end
function discoverPort(conn)
	if not State.getPluginSettings().autoPortDiscovery then
		return nil
	end
	local _result = conn
	if _result ~= nil then
		_result = _result.serverUrl
	end
	local _condition = _result
	if _condition == nil then
		_condition = State.getActiveConnection().serverUrl
	end
	local host = State.getServerHost(_condition)
	local firstActivePort
	for offset = 0, 4 do
		local port = State.BASE_PORT + offset
		local success, result = pcall(function()
			return HttpService:RequestAsync({
				Url = `http://{host}:{port}/status`,
				Method = "GET",
				Headers = {
					["Content-Type"] = "application/json",
				},
			})
		end)
		if success and result.Success then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(result.Body)
			end)
			if ok and data.mcpServerActive then
				if data.pluginConnected then
					return port
				end
				if firstActivePort == nil then
					firstActivePort = port
				end
			end
		end
	end
	return firstActivePort
end
function sendReadyHandshake(conn)
	local settings = State.getPluginSettings()
	local sessionId = State.getPluginSessionId()
	local metadata = getStudioMetadata()
	local ok, result = pcall(function()
		return HttpService:RequestAsync({
			Url = `{conn.serverUrl}/ready`,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
			},
			Body = HttpService:JSONEncode({
				pluginReady = true,
				timestamp = tick(),
				version = State.CURRENT_VERSION,
				pluginInstanceId = sessionId,
				sessionId = sessionId,
				serverUrl = conn.serverUrl,
				placeId = metadata.placeId,
				placeName = metadata.placeName,
				gameId = metadata.gameId,
				capabilities = getPluginCapabilities(),
				profile = {
					parallelAgents = settings.parallelAgents,
					useLightModel = settings.useLightModel,
					useStructureMapping = settings.useStructureMapping,
					teamPreset = settings.teamPreset,
					reviewerLightMode = settings.reviewerLightMode,
					qaLightMode = settings.qaLightMode,
					teamOrchestrator = buildTeamOrchestratorProfile(settings),
				},
			}),
		})
	end)
	return ok and isHandshakeHttpSuccess(result)
end
local function discoverAndApplyActivePort()
	local idx = State.getActiveTabIndex()
	local conn = State.getConnection(idx)
	if not conn then
		return nil
	end
	local discovered = discoverPort(conn)
	if discovered ~= nil and discovered ~= conn.port then
		conn.port = discovered
		conn.serverUrl = State.replaceConnectionPort(conn.serverUrl, discovered)
		local el = UI.getElements()
		el.urlInput.Text = conn.serverUrl
		log("success", "Port discovered", `Switched active connection to {discovered}`)
		return discovered
	end
	if discovered == nil then
		log("warn", "Port discovery", "No active MCP endpoint found in scan range")
	else
		log("info", "Port discovery", `Already on best port {discovered}`)
	end
	return discovered
end
local function refreshStructureMapFromQuickAction()
	if not isStructureMapEnabled() then
		log("warn", "Structure map", "Feature disabled in settings", {
			endpoint = "/api/refresh-structure-map",
			category = "structure",
		})
		UI.refreshAgentMappingSection()
		UI.refreshStructureExplorerSection()
		return nil
	end
	local ok, result = pcall(function()
		return StructureMap.refreshStructureMap({})
	end)
	if ok then
		local version = result.version
		log("success", "Structure map refreshed", `Version {tostring(version)}`, {
			endpoint = "/api/refresh-structure-map",
			category = "structure",
		})
	else
		log("error", "Structure map refresh failed", tostring(result), {
			endpoint = "/api/refresh-structure-map",
			category = "error",
			error = result,
			retryContext = {
				endpoint = "/api/refresh-structure-map",
				payload = {},
			},
		})
	end
	UI.refreshAgentMappingSection()
	UI.refreshStructureExplorerSection()
end
local function runBootstrapPing(connIndex, options)
	if not options.sendImmediatePing then
		return nil
	end
	task.spawn(function()
		do
			local attempt = 0
			local _shouldIncrement = false
			while true do
				if _shouldIncrement then
					attempt += 1
				else
					_shouldIncrement = true
				end
				if not (attempt < options.bootstrapRetryCount) then
					break
				end
				local conn = State.getConnection(connIndex)
				if not conn or not conn.isActive then
					return nil
				end
				local readyOk = sendReadyHandshake(conn)
				if readyOk then
					log("success", if attempt == 0 then "Ready handshake sent" else "Ready handshake retried", conn.serverUrl)
				elseif attempt == options.bootstrapRetryCount - 1 then
					log("warn", "Ready handshake failed", conn.serverUrl)
				end
				pollForRequests(connIndex)
				updateDiagnosticsFromServer(conn)
				if conn.lastHttpOk then
					return nil
				end
				task.wait(options.bootstrapRetryDelaySeconds)
			end
		end
	end)
end
local function activatePlugin(connIndex, options)
	local _condition = connIndex
	if _condition == nil then
		_condition = State.getActiveTabIndex()
	end
	local idx = _condition
	local conn = State.getConnection(idx)
	if not conn then
		return nil
	end
	local ui = UI.getElements()
	local activationOptions = options or {
		showUi = true,
		sendImmediatePing = true,
		bootstrapRetryCount = 1,
		bootstrapRetryDelaySeconds = 0.5,
	}
	local showUi = activationOptions.showUi
	conn.isActive = true
	conn.consecutiveFailures = 0
	conn.currentRetryDelay = 0.5
	conn.lastHttpOk = false
	conn.lastMcpConnected = false
	if showUi then
		ui.screenGui.Enabled = true
	end
	if idx == State.getActiveTabIndex() then
		conn.serverUrl = ui.urlInput.Text
		local portStr = string.match(conn.serverUrl, ":(%d+)$")
		if portStr ~= 0 and portStr == portStr and portStr ~= "" and portStr then
			local _condition_1 = tonumber(portStr)
			if _condition_1 == nil then
				_condition_1 = conn.port
			end
			conn.port = _condition_1
		end
		UI.updateUIState()
	end
	UI.updateTabDot(idx)
	log("info", "Connection activated", `Activating plugin on {conn.serverUrl}`)
	task.spawn(function()
		local discoveredPort = discoverPort(conn)
		if discoveredPort ~= nil then
			conn.port = discoveredPort
			conn.serverUrl = State.replaceConnectionPort(conn.serverUrl, discoveredPort)
			if idx == State.getActiveTabIndex() then
				ui.urlInput.Text = conn.serverUrl
			end
		end
		if not conn.heartbeatConnection then
			conn.heartbeatConnection = RunService.Heartbeat:Connect(function()
				local now = tick()
				local currentInterval = if conn.consecutiveFailures > 5 then conn.currentRetryDelay else conn.pollInterval
				if now - conn.lastPoll > currentInterval then
					conn.lastPoll = now
					pollForRequests(idx)
				end
			end)
		end
		runBootstrapPing(idx, activationOptions)
	end)
end
local function deactivatePlugin(connIndex)
	local _condition = connIndex
	if _condition == nil then
		_condition = State.getActiveTabIndex()
	end
	local idx = _condition
	local conn = State.getConnection(idx)
	if not conn then
		return nil
	end
	conn.isActive = false
	conn.lastHttpOk = false
	conn.lastMcpConnected = false
	log("info", "Connection deactivated", `Disconnected from {conn.serverUrl}`)
	if idx == State.getActiveTabIndex() then
		UI.updateUIState()
	end
	UI.updateTabDot(idx)
	pcall(function()
		local sessionId = State.getPluginSessionId()
		HttpService:RequestAsync({
			Url = `{conn.serverUrl}/disconnect`,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["x-mcp-session-id"] = sessionId,
			},
			Body = HttpService:JSONEncode({
				timestamp = tick(),
				sessionId = sessionId,
			}),
		})
	end)
	if conn.heartbeatConnection then
		conn.heartbeatConnection:Disconnect()
		conn.heartbeatConnection = nil
	end
	conn.consecutiveFailures = 0
	conn.currentRetryDelay = 0.5
	UI.updateDiagnosticsPanel({
		serverReachable = false,
		serverMessage = "disconnected",
		bridgeStatus = "offline",
		pluginStatus = "disconnected",
		mcpStatus = "inactive",
		endpointSupport = "unknown",
		cacheStatus = "unknown",
		writeQueueStatus = "unknown",
		lastErrorSummary = "none",
		lastErrorCause = "Connect plugin to refresh diagnostics.",
		lastUpdatedAtText = DateTime.fromUnixTimestamp(math.floor(tick())):FormatLocalTime("HH:mm:ss", "en-us"),
	})
end
local function deactivateAll()
	do
		local i = 0
		local _shouldIncrement = false
		while true do
			if _shouldIncrement then
				i += 1
			else
				_shouldIncrement = true
			end
			if not (i < arrayCount(State.getConnections())) then
				break
			end
			if State.getConnections()[i + 1].isActive then
				deactivatePlugin(i)
			end
		end
	end
end
local function checkForUpdates()
	task.spawn(function()
		local success, result = pcall(function()
			return HttpService:RequestAsync({
				Url = "https://registry.npmjs.org/robloxstudio-mcp/latest",
				Method = "GET",
				Headers = {
					Accept = "application/json",
				},
			})
		end)
		if success and result.Success then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(result.Body)
			end)
			local _condition = ok
			if _condition then
				local _result = data
				if _result ~= nil then
					_result = _result.version
				end
				_condition = _result
			end
			if _condition ~= "" and _condition then
				local latestVersion = data.version
				if Utils.compareVersions(State.CURRENT_VERSION, latestVersion) < 0 then
					local ui = UI.getElements()
					ui.updateBannerText.Text = `v{latestVersion} available - github.com/boshyxd/robloxstudio-mcp`
					ui.updateBanner.Visible = true
					ui.contentFrame.Position = UDim2.new(0, 8, 0, 92)
					ui.contentFrame.Size = UDim2.new(1, -16, 1, -100)
				end
			end
		end
	end)
end
return {
	getConnectionStatus = getConnectionStatus,
	activatePlugin = activatePlugin,
	deactivatePlugin = deactivatePlugin,
	deactivateAll = deactivateAll,
	discoverAndApplyActivePort = discoverAndApplyActivePort,
	refreshStructureMapFromQuickAction = refreshStructureMapFromQuickAction,
	sendReadyHandshakeForActive = function()
		local conn = State.getActiveConnection()
		if not conn then
			return false
		end
		local ok = sendReadyHandshake(conn)
		if ok then
			log("success", "Manual MCP sync", conn.serverUrl)
			updateDiagnosticsFromServer(conn)
		else
			log("error", "Manual MCP sync failed", conn.serverUrl, {
				error = "ready handshake failed",
				retryContext = {
					endpoint = "/ready",
					payload = {
						serverUrl = conn.serverUrl,
					},
				},
			})
		end
		return ok
	end,
	clearActivityFeed = function()
		State.clearActivity()
		UI.pushActivity("info", "Activity feed", "Feed cleared")
	end,
	checkForUpdates = checkForUpdates,
	retryFailedActivity = retryFailedActivity,
}
