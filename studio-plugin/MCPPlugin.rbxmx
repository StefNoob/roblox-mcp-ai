        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">CrossSessionHandlers</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(script.Parent.Parent.Parent.include.RuntimeLib)
local _services = TS.import(script, script.Parent.Parent.Parent, "node_modules", "@rbxts", "services")
local CollectionService = _services.CollectionService
local HttpService = _services.HttpService
local Utils = TS.import(script, script.Parent.Parent, "Utils")
local ScriptEditorService = game:GetService("ScriptEditorService")
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local _binding = Utils
local getInstancePath = _binding.getInstancePath
local getInstanceByPath = _binding.getInstanceByPath
local readScriptSource = _binding.readScriptSource
local COMMON_PROPERTIES = { "Archivable" }
local BASE_PART_PROPERTIES = { "Anchored", "CanCollide", "CanTouch", "CanQuery", "Transparency", "Material", "Color", "Size", "CFrame", "CastShadow", "Locked", "Massless" }
local MODEL_PROPERTIES = { "WorldPivot" }
local ATTACHMENT_PROPERTIES = { "Position", "Orientation", "Axis", "SecondaryAxis", "Visible" }
local PROXIMITY_PROMPT_PROPERTIES = { "ActionText", "ObjectText", "KeyboardKeyCode", "GamepadKeyCode", "HoldDuration", "MaxActivationDistance", "RequiresLineOfSight", "ClickablePrompt", "Enabled", "Style" }
local GUI_PROPERTIES = { "Visible", "Active", "ZIndex", "BackgroundTransparency", "BackgroundColor3", "Size", "Position" }
local BASE_SCRIPT_PROPERTIES = { "Enabled", "Disabled" }
local function arrayCount(items)
	local count = 0
	for _, _item in items do
		count += 1
	end
	return count
end
local function isTable(value)
	local _value = value
	return type(_value) == "table"
end
local function joinRelativePath(parentPath, name)
	if parentPath == "" then
		return name
	end
	return `{parentPath}/{name}`
end
local function getRelativePath(root, instance)
	if instance == root then
		return ""
	end
	local parts = {}
	local current = instance
	while current and current ~= root and current ~= game do
		local _name = current.Name
		table.insert(parts, 1, _name)
		current = current.Parent
	end
	return table.concat(parts, "/")
end
local function getPropertyAllowlist(instance)
	local _array = {}
	local _length = #_array
	table.move(COMMON_PROPERTIES, 1, #COMMON_PROPERTIES, _length + 1, _array)
	local allow = _array
	if instance:IsA("BasePart") then
		for _, prop in BASE_PART_PROPERTIES do
			table.insert(allow, prop)
		end
	end
	if instance:IsA("Model") then
		for _, prop in MODEL_PROPERTIES do
			table.insert(allow, prop)
		end
	end
