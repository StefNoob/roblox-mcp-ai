        <Properties>
          <string name="Name">MappingSummary</string>
          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local ROOT_PREVIEW_LIMIT = 8
local SUBSYSTEM_PREVIEW_LIMIT = 8
local SCRIPT_PREVIEW_LIMIT = 8
local function arrayCount(items)
	local count = 0
	for _, _item in items do
		count += 1
	end
	return count
end
local function stringSub(text, start, finish)
	return string.sub(text, start, finish)
end
local function stripGamePrefix(path)
	if stringSub(path, 1, 5) == "game." then
		return stringSub(path, 6)
	end
	return path
end
local function insertSortedLimited(items, value, limit)
	local inserted = false
	do
		local index = 0
		local _shouldIncrement = false
		while true do
			if _shouldIncrement then
				index += 1
			else
				_shouldIncrement = true
			end
			if not (index < arrayCount(items)) then
				break
			end
			if value < items[index + 1] then
				local _items = items
				local _value = value
				table.insert(_items, _value)
				do
					local cursor = arrayCount(items) - 1
					local _shouldIncrement_1 = false
					while true do
						if _shouldIncrement_1 then
							cursor -= 1
						else
							_shouldIncrement_1 = true
						end
						if not (cursor > index) then
							break
						end
						local temp = items[cursor]
						items[cursor] = items[cursor + 1]
						items[cursor + 1] = temp
					end
				end
				inserted = true
				break
			end
		end
	end
	if not inserted and arrayCount(items) < limit then
		local _items = items
		local _value = value
		table.insert(_items, _value)
		inserted = true
	end
	if not inserted then
		return nil
	end
	if arrayCount(items) > limit then
		items[#items] = nil
	end
end
local function buildAgentMappingSnapshot(summary, nodes)
	local subsystemCounts = {}
	local scriptPathsPreview = {}
	local scriptTotal = 0
	for _, node in nodes do
		local _condition = node.subsystem
		if _condition ~= "" and _condition then
			_condition = node.subsystem ~= ""
		end
		if _condition ~= "" and _condition then
			local _exp = node.subsystem
			local _subsystem = node.subsystem
			local _condition_1 = subsystemCounts[_subsystem]
			if _condition_1 == nil then
				_condition_1 = 0
			end
			subsystemCounts[_exp] = _condition_1 + 1
		end
		if node.hasSource then
			scriptTotal += 1
			insertSortedLimited(scriptPathsPreview, stripGamePrefix(node.path), SCRIPT_PREVIEW_LIMIT)
		end
	end
	local rootsPreview = {}
	for _, root in summary.roots do
		if arrayCount(rootsPreview) >= ROOT_PREVIEW_LIMIT then
			break
		end
		local _arg0 = stripGamePrefix(root)
		table.insert(rootsPreview, _arg0)
	end
	local subsystemNames = {}
	-- ▼ ReadonlyMap.forEach ▼
	local _callback = function(_, name)
		local _name = name
		table.insert(subsystemNames, _name)
	end
	for _k, _v in subsystemCounts do
		_callback(_v, _k, subsystemCounts)
	end
	-- ▲ ReadonlyMap.forEach ▲
	do
		local i = 0
		local _shouldIncrement = false
		while true do
			if _shouldIncrement then
				i += 1
			else
				_shouldIncrement = true
			end
			if not (i < arrayCount(subsystemNames)) then
				break
			end
			do
				local j = i + 1
				local _shouldIncrement_1 = false
				while true do
					if _shouldIncrement_1 then
						j += 1
					else
						_shouldIncrement_1 = true
					end
					if not (j < arrayCount(subsystemNames)) then
						break
					end
					local left = subsystemNames[i + 1]
					local right = subsystemNames[j + 1]
					local _condition = subsystemCounts[left]
					if _condition == nil then
						_condition = 0
					end
					local leftCount = _condition
					local _condition_1 = subsystemCounts[right]
					if _condition_1 == nil then
						_condition_1 = 0
					end
					local rightCount = _condition_1
					local shouldSwap = rightCount > leftCount or (rightCount == leftCount and right < left)
					if shouldSwap then
						subsystemNames[i + 1] = right
						subsystemNames[j + 1] = left
					end
				end
			end
		end
	end
	local subsystemPreview = {}
	for _, name in subsystemNames do
		if arrayCount(subsystemPreview) >= SUBSYSTEM_PREVIEW_LIMIT then
			break
		end
		local _condition = subsystemCounts[name]
		if _condition == nil then
			_condition = 0
		end
		local _arg0 = `{name} ({_condition})`
		table.insert(subsystemPreview, _arg0)
	end
	return {
		headline = `{summary.nodeCount} nodes mapped | {summary.scriptCount} scripts ready`,
		meta = `{summary.rootCount} roots | {arrayCount(subsystemNames)} subsystems | v{summary.version}`,
		context = `Place {summary.placeName} | reason {summary.lastReason}`,
		roots = rootsPreview,
		rootTotal = summary.rootCount,
		subsystems = subsystemPreview,
		subsystemTotal = arrayCount(subsystemNames),
		scripts = scriptPathsPreview,
		scriptTotal = scriptTotal,
	}
end
return {
	buildAgentMappingSnapshot = buildAgentMappingSnapshot,
}
]]></string>
