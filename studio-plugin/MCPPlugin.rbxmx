end
local function removeConnection(index)
	if arrayCount(connections) <= 1 then
		return false
	end
	if index < 0 or index >= arrayCount(connections) then
		return false
	end
	if connections[index + 1].isActive then
		return false
	end
	local _index = index
	table.remove(connections, _index + 1)
	if activeTabIndex >= arrayCount(connections) then
		activeTabIndex = arrayCount(connections) - 1
	elseif activeTabIndex > index then
		activeTabIndex -= 1
