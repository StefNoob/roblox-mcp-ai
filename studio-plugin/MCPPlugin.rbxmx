local function isStructureMapEnabled()
	return State.getPluginSettings().useStructureMapping
end
local function buildTeamOrchestratorProfile(settings)
	local isThroughput = settings.teamPreset == "throughput"
	local isTokenSaver = settings.teamPreset == "tokenSaver"
	local maxConcurrency = settings.parallelAgents
	local coreWeight = if isThroughput then 5 elseif isTokenSaver then 2 else 3
	local reviewerWeight = if isTokenSaver then 2 else 1
	local qaWeight = if isTokenSaver then 2 else 1
	local backgroundWeight = 1
	local reviewerMax = if settings.reviewerLightMode then 1 else 2
	local qaMax = if settings.qaLightMode then 1 else 2
	local coreMax = if isTokenSaver then math.max(1, maxConcurrency - 1) else maxConcurrency
	return {
		maxConcurrency = maxConcurrency,
		defaultTeamId = "core",
		laneWeights = {
			core = coreWeight,
			reviewer = reviewerWeight,
			qa = qaWeight,
			background = backgroundWeight,
		},
		teams = {
			core = {
				lane = "core",
				maxInFlight = coreMax,
				tokenMode = if settings.useLightModel then "light" else "standard",
				weight = coreWeight,
			},
			reviewer = {
				lane = "reviewer",
				maxInFlight = reviewerMax,
				tokenMode = if settings.reviewerLightMode then "light" else "standard",
				weight = reviewerWeight,
			},
			qa = {
				lane = "qa",
				maxInFlight = qaMax,
				tokenMode = if settings.qaLightMode then "light" else "standard",
				weight = qaWeight,
			},
			background = {
				lane = "background",
				maxInFlight = 1,
				tokenMode = if settings.useLightModel then "light" else "standard",
				weight = backgroundWeight,
			},
		},
	}
end
