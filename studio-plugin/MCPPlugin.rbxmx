        <Properties>
          <string name="Name">ConnectionStatus</string>
          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local function deriveConnectionPhase(conn)
	if not conn.isActive then
		return "disconnected"
	end
	if conn.consecutiveFailures >= conn.maxFailuresBeforeError then
		return "error"
	end
	if conn.lastHttpOk and conn.lastMcpConnected then
		return "connected"
	end
	if conn.lastHttpOk then
		return "waiting"
	end
	if conn.consecutiveFailures > 5 then
		return "retry"
	end
	return "connecting"
end
return {
	deriveConnectionPhase = deriveConnectionPhase,
}
]]></string>
