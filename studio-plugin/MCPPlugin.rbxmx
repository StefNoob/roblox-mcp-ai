	local afterSliceStart = findLineStart(normalized, actualEndLine + 1)
	local extracted = if afterSliceStart ~= nil then string.sub(normalized, sliceStart, afterSliceStart - 2) else string.sub(normalized, sliceStart)
	if hasTrailingNewline and actualEndLine == totalLineCount and string.sub(extracted, -1) ~= "\n" then
		extracted ..= "\n"
