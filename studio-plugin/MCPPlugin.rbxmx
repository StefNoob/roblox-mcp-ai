      <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(script.include.RuntimeLib)
local State = TS.import(script, script, "modules", "State")
local UI = TS.import(script, script, "modules", "UI")
local Communication = TS.import(script, script, "modules", "Communication")
local StructureMap = TS.import(script, script, "modules", "StructureMap")
local getActivationOptions = TS.import(script, script, "modules", "ActivationMode").getActivationOptions
UI.init(plugin)
StructureMap.init()
UI.refreshAgentMappingSection()
local elements = UI.getElements()
local function arrayCount(items)
	local count = 0
	for _, _item in items do
		count += 1
	end
	return count
end
local function syncConnectionTabs(target)
	local desired = math.clamp(target, 1, State.MAX_CONNECTIONS)
	while arrayCount(State.getConnections()) < desired do
		State.addConnection()
	end
	while arrayCount(State.getConnections()) > desired do
		local lastIndex = arrayCount(State.getConnections()) - 1
		local lastConn = State.getConnection(lastIndex)
		if not lastConn or lastConn.isActive then
			break
		end
		if not State.removeConnection(lastIndex) then
			break
		end
	end
end
syncConnectionTabs(State.getPluginSettings().parallelAgents)
UI.refreshConnectionTabs()
UI.updateUIState()
local startupConnection = State.getActiveConnection()
if startupConnection and not startupConnection.isActive then
	Communication.activatePlugin(State.getActiveTabIndex(), getActivationOptions("startup"))
end
UI.setQuickActions({
	onRefreshStructureMap = function()
		return Communication.refreshStructureMapFromQuickAction()
	end,
	onDiscoverPort = function()
		return Communication.discoverAndApplyActivePort()
	end,
	onSendReadyHandshake = function()
		return Communication.sendReadyHandshakeForActive()
	end,
	onClearActivity = function()
		return Communication.clearActivityFeed()
	end,
	onRetryFailedActivity = function(retryContext)
		return Communication.retryFailedActivity(retryContext)
	end,
})
UI.setSettingsChangedHandler(function(settings)
	syncConnectionTabs(settings.parallelAgents)
	UI.refreshConnectionTabs()
	UI.refreshAgentMappingSection()
	UI.refreshStructureExplorerSection()
	UI.pushActivity("info", "Settings updated", `Agents {settings.parallelAgents}, preset {settings.teamPreset}, reviewer {if settings.reviewerLightMode then "light" else "standard"}, qa {if settings.qaLightMode then "light" else "standard"}`)
end)
local toolbar = plugin:CreateToolbar("MCP Integration")
local button = toolbar:CreateButton("MCP Server", "Connect to MCP Server for AI Integration", "rbxassetid://10734944444")
elements.connectButton.Activated:Connect(function()
	local conn = State.getActiveConnection()
	if conn and conn.isActive then
		Communication.deactivatePlugin(State.getActiveTabIndex())
	else
		Communication.activatePlugin(State.getActiveTabIndex(), getActivationOptions("manual"))
	end
end)
button.Click:Connect(function()
	elements.screenGui.Enabled = not elements.screenGui.Enabled
end)
plugin.Unloading:Connect(function()
	Communication.deactivateAll()
	StructureMap.shutdown()
end)
UI.updateUIState()
Communication.checkForUpdates()

]]></string>
