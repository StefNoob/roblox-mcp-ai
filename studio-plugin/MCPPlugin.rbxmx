	end
	if settingsControls.reviewerLightToggle then
		settingsControls.reviewerLightToggle.Text = if settings.reviewerLightMode then "ON" else "OFF"
		settingsControls.reviewerLightToggle.TextColor3 = if settings.reviewerLightMode then C.green else C.muted
	end
	if settingsControls.qaLightToggle then
		settingsControls.qaLightToggle.Text = if settings.qaLightMode then "ON" else "OFF"
		settingsControls.qaLightToggle.TextColor3 = if settings.qaLightMode then C.green else C.muted
	end
	if settingsControls.mappingToggle then
		settingsControls.mappingToggle.Text = if settings.useStructureMapping then "ON" else "OFF"
		settingsControls.mappingToggle.TextColor3 = if settings.useStructureMapping then C.green else C.muted
	end
	if settingsControls.autoPortToggle then
		settingsControls.autoPortToggle.Text = if settings.autoPortDiscovery then "ON" else "OFF"
		settingsControls.autoPortToggle.TextColor3 = if settings.autoPortDiscovery then C.green else C.muted
	end
	if settingsControls.verboseToggle then
		settingsControls.verboseToggle.Text = if settings.verboseActivity then "ON" else "OFF"
		settingsControls.verboseToggle.TextColor3 = if settings.verboseActivity then C.green else C.muted
	end
	if settingsSummaryLabel then
		settingsSummaryLabel.Text = `Agents {settings.parallelAgents} | ` .. `Preset {formatTeamPresetLabel(settings.teamPreset)} | ` .. `Reviewer {if settings.reviewerLightMode then "Light" else "Standard"} | ` .. `Q&A {if settings.qaLightMode then "Light" else "Standard"}`
	end
end
local function commitSettings(patch)
	local updated = State.updatePluginSettings(patch)
	applySettingsUI(updated)
	saveSettings(updated)
	if onSettingsChanged then
		onSettingsChanged(updated)
	end
end
local function formatTime(t)
	local date = DateTime.fromUnixTimestamp(math.floor(t))
	return date:FormatLocalTime("HH:mm:ss", "en-us")
end
local function levelColor(level)
	if level == "success" then
		return C.green
	end
	if level == "warn" then
		return C.yellow
	end
	if level == "error" then
		return C.red
	end
	return C.blue
end
local function inferActivityCategory(level, endpoint)
	if level == "error" then
		return "error"
	end
	local _condition = endpoint
	if _condition ~= "" and _condition then
		_condition = ((string.find(endpoint, "structure-map")) ~= nil or (string.find(endpoint, "script-inventory")) ~= nil or (string.find(endpoint, "project-structure")) ~= nil)
	end
	if _condition ~= "" and _condition then
		return "structure"
	end
	local _condition_1 = endpoint
	if _condition_1 ~= "" and _condition_1 then
		_condition_1 = ((string.find(endpoint, "/set-")) ~= nil or (string.find(endpoint, "/edit-")) ~= nil or (string.find(endpoint, "/insert-")) ~= nil or (string.find(endpoint, "/delete-")) ~= nil or (string.find(endpoint, "/create-")) ~= nil or (string.find(endpoint, "/add-")) ~= nil or (string.find(endpoint, "/remove-")) ~= nil)
	end
	if _condition_1 ~= "" and _condition_1 then
		return "write"
	end
	if endpoint ~= nil then
		return "read"
	end
	return "system"
end
local function toActivityOptions(options)
	local _options = options
	if type(_options) == "string" then
		return {
			endpoint = options,
		}
	end
	return options or {}
end
local function stringifyPayload(payload)
	if payload == nil then
		return nil
	end
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(payload)
	end)
	if ok and type(encoded) == "string" then
		return encoded
	end
	return tostring(payload)
end
local function extractPathFromPayload(payload)
	local _condition = not (payload ~= 0 and payload == payload and payload ~= "" and payload)
	if not _condition then
		local _payload = payload
		_condition = not (type(_payload) == "table")
	end
	if _condition then
		return nil
	end
	local data = payload
	local candidates = { data.instancePath, data.path, data.parent, data.rootPath }
	for _, candidate in candidates do
		if type(candidate) == "string" and #candidate > 0 then
			return candidate
		end
	end
	return nil
end
local function isActivityVisibleByFilter(item)
	if item.category == "write" then
		return activityFilters.write
	end
	if item.category == "error" then
		return activityFilters.error
	end
	if item.category == "structure" then
		return activityFilters.structure
	end
	return activityFilters.read
end
local function updateActivityFilterButtons()
	if activityFilterReadBtn then
		activityFilterReadBtn.Text = `Reads {if activityFilters.read then "ON" else "OFF"}`
		activityFilterReadBtn.TextColor3 = if activityFilters.read then C.green else C.muted
	end
	if activityFilterWriteBtn then
		activityFilterWriteBtn.Text = `Writes {if activityFilters.write then "ON" else "OFF"}`
		activityFilterWriteBtn.TextColor3 = if activityFilters.write then C.green else C.muted
	end
	if activityFilterErrorBtn then
		activityFilterErrorBtn.Text = `Errors {if activityFilters.error then "ON" else "OFF"}`
		activityFilterErrorBtn.TextColor3 = if activityFilters.error then C.green else C.muted
	end
	if activityFilterStructureBtn then
		activityFilterStructureBtn.Text = `Structure {if activityFilters.structure then "ON" else "OFF"}`
		activityFilterStructureBtn.TextColor3 = if activityFilters.structure then C.green else C.muted
	end
	if activityGroupBtn then
		activityGroupBtn.Text = if activityGroupedByPath then "Group: path" else "Group: timeline"
		activityGroupBtn.TextColor3 = if activityGroupedByPath then C.green else C.muted
	end
end
local function copyToClipboard(text)
	if not (text ~= "" and text) or #text == 0 then
		return false
	end
	local ok = pcall(function()
		StudioService.CopyToClipboard(text)
	end)
	return ok
end
local function inferProbableCause(errorText)
	local lowered = string.lower(errorText)
	if (string.find(lowered, "timeout")) ~= nil then
		return "Likely network timeout between plugin and MCP bridge."
	end
	if (string.find(lowered, "stale")) ~= nil or (string.find(lowered, "heartbeat")) ~= nil then
		return "Likely stale plugin heartbeat; reconnect plugin or restart Studio."
	end
	if (string.find(lowered, "not connected")) ~= nil or (string.find(lowered, "unavailable")) ~= nil then
		return "Likely bridge/server disconnected; verify MCP server process and port."
	end
	if (string.find(lowered, "unknown endpoint")) ~= nil then
		return "Likely plugin/server version mismatch (missing endpoint support)."
	end
	if (string.find(lowered, "write operation blocked")) ~= nil or (string.find(lowered, "play mode")) ~= nil then
		return "Likely Studio write safety guard (play mode or read-only state)."
	end
	return "Inspect payload and endpoint details for the failing action."
end
local function copyActivityData(item)
	local payload = item.payloadText
	local errorText = item.errorText
	local _condition = errorText
	if _condition == nil then
		_condition = payload
		if _condition == nil then
			_condition = `{item.title}\n{item.detail}`
		end
	end
	local text = _condition
	return copyToClipboard(text)
end
local pushActivity
local function rebuildActivityRows()
	local panel = viewPanels.activity
	if not panel then
		return nil
	end
	local list = panel:FindFirstChild("ActivityList")
	if not list then
		return nil
	end
	-- ▼ ReadonlyMap.forEach ▼
	local _callback = function(row)
		return row:Destroy()
	end
	for _k, _v in activityRows do
		_callback(_v, _k, activityRows)
	end
	-- ▲ ReadonlyMap.forEach ▲
	table.clear(activityRows)
	local allItems = State.getActivity()
	local filtered = {}
	for _, item in allItems do
		if isActivityVisibleByFilter(item) then
			table.insert(filtered, item)
		end
	end
	if arrayCount(filtered) == 0 then
		local emptyLabel = Instance.new("TextLabel")
		emptyLabel.Name = "EmptyLabel"
		emptyLabel.Size = UDim2.new(1, 0, 0, 22)
		emptyLabel.BackgroundTransparency = 1
		emptyLabel.Text = "No activity for the current filters."
		emptyLabel.TextColor3 = C.muted
		emptyLabel.TextSize = 10
		emptyLabel.Font = Enum.Font.GothamMedium
		emptyLabel.TextXAlignment = Enum.TextXAlignment.Left
		emptyLabel.Parent = list
		activityRows[-1] = emptyLabel
		return nil
	end
	local groups = {}
	if not activityGroupedByPath then
		for _, item in filtered do
			local _arg0 = {
				key = tostring(item.id),
				items = { item },
			}
			table.insert(groups, _arg0)
		end
	else
		local order = {}
		local buckets = {}
		for _, item in filtered do
			local _condition = item.groupKey
			if _condition == nil then
				_condition = item.path
				if _condition == nil then
					_condition = item.endpoint
					if _condition == nil then
						_condition = item.title
					end
				end
			end
			local key = _condition
			if not (buckets[key] ~= nil) then
				buckets[key] = {}
				table.insert(order, key)
			end
			local _exp = buckets[key]
			table.insert(_exp, item)
		end
		for _, key in order do
			local bucket = buckets[key]
			if not bucket or arrayCount(bucket) == 0 then
				continue
			end
			local _arg0 = {
				key = key,
				items = bucket,
			}
			table.insert(groups, _arg0)
		end
	end
	local layoutOrder = 0
	for _, group in groups do
		layoutOrder += 1
		local item = group.items[1]
		local groupedCount = arrayCount(group.items)
		local canRetry = item.retryContext ~= nil
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 50)
		row.BackgroundColor3 = C.surfaceAlt
		row.BorderSizePixel = 0
		row.LayoutOrder = layoutOrder
		row.Parent = list
		local corner = Instance.new("UICorner")
		corner.CornerRadius = CORNER
		corner.Parent = row
		local dot = Instance.new("Frame")
		dot.Size = UDim2.new(0, 6, 0, 6)
		dot.Position = UDim2.new(0, 8, 0, 8)
		dot.BackgroundColor3 = levelColor(item.level)
		dot.BorderSizePixel = 0
		dot.Parent = row
		local dotCorner = Instance.new("UICorner")
		dotCorner.CornerRadius = UDim.new(1, 0)
		dotCorner.Parent = dot
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, -156, 0, 16)
		title.Position = UDim2.new(0, 20, 0, 2)
		title.BackgroundTransparency = 1
		title.Text = if groupedCount > 1 then `{item.title} ({groupedCount})` else item.title
		title.TextColor3 = C.label
		title.TextSize = 10
		title.Font = Enum.Font.GothamSemibold
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.TextTruncate = Enum.TextTruncate.AtEnd
		title.Parent = row
		local detail = Instance.new("TextLabel")
		detail.Size = UDim2.new(1, -156, 0, 16)
		detail.Position = UDim2.new(0, 20, 0, 18)
		detail.BackgroundTransparency = 1
		local _result
		if activityGroupedByPath then
			local _condition = item.path
			if _condition == nil then
				_condition = item.endpoint
				if _condition == nil then
					_condition = group.key
				end
			end
			_result = `{_condition} | {item.detail}`
		else
			_result = item.detail
		end
		detail.Text = _result
		detail.TextColor3 = C.muted
		detail.TextSize = 9
		detail.Font = Enum.Font.GothamMedium
		detail.TextXAlignment = Enum.TextXAlignment.Left
		detail.TextTruncate = Enum.TextTruncate.AtEnd
		detail.Parent = row
		local stamp = Instance.new("TextLabel")
		stamp.Size = UDim2.new(0, 68, 0, 14)
		stamp.Position = UDim2.new(1, -72, 0, 2)
		stamp.BackgroundTransparency = 1
		stamp.Text = formatTime(item.timestamp)
		stamp.TextColor3 = C.muted
		stamp.TextSize = 8
		stamp.Font = Enum.Font.GothamMedium
		stamp.TextXAlignment = Enum.TextXAlignment.Right
		stamp.Parent = row
		local copyBtn = createTextButton(row, "Copy", UDim2.new(0, 44, 0, 18))
		copyBtn.Position = UDim2.new(1, -94, 0, 24)
		copyBtn.TextSize = 8
		copyBtn.Activated:Connect(function()
			local copied = copyActivityData(item)
			if copied then
				pushActivity("success", "Copied activity payload", `Copied data for {item.title}`)
			else
				pushActivity("warn", "Copy failed", "Clipboard write is unavailable in this Studio context.")
			end
		end)
		if canRetry then
			local retryBtn = createTextButton(row, "Retry", UDim2.new(0, 44, 0, 18))
			retryBtn.Position = UDim2.new(1, -46, 0, 24)
			retryBtn.TextSize = 8
			retryBtn.Activated:Connect(function()
				local retryContext = item.retryContext
				if not retryContext or not quickActionHandlers.onRetryFailedActivity then
					pushActivity("warn", "Retry unavailable", "No retry handler is available for this activity.")
					return nil
				end
				quickActionHandlers.onRetryFailedActivity(retryContext)
			end)
		end
		local _id = item.id
		activityRows[_id] = row
	end
end
local refreshAgentMappingSection, rebuildStructureExplorerList
local function setActiveView(view)
	activeView = view
	for k, panel in viewPanels do
		panel.Visible = k == view
	end
	for k, btn in viewButtons do
		local active = k == view
		btn.BackgroundColor3 = if active then C.subtle else C.surface
		btn.TextColor3 = if active then C.label else C.muted
	end
	if view == "activity" then
		rebuildActivityRows()
	end
	if view == "overview" then
		refreshAgentMappingSection()
		rebuildStructureExplorerList()
	end
end
local function createRowLabel(parent, text)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 12)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = C.muted
	label.TextSize = 9
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = parent
	return label
end
local function formatMappingList(prefix, items, emptyText, limit, totalCount)
	if arrayCount(items) == 0 then
		return `{prefix}: {emptyText}`
	end
	local limited = {}
	do
		local index = 0
		local _shouldIncrement = false
		while true do
			if _shouldIncrement then
				index += 1
			else
				_shouldIncrement = true
			end
			if not (index < math.min(arrayCount(items), limit)) then
				break
			end
			local _arg0 = items[index + 1]
			table.insert(limited, _arg0)
		end
	end
	local _condition = totalCount
	if _condition == nil then
		_condition = arrayCount(items)
	end
	local effectiveTotal = _condition
	local suffix = if effectiveTotal > limit then ` +{effectiveTotal - limit} more` else ""
	return `{prefix}: {table.concat(limited, ", ")}{suffix}`
end
local function applyAgentMappingSnapshot(snapshot)
	if not agentMappingHeadlineLabel or not agentMappingMetaLabel or not agentMappingContextLabel then
		return nil
	end
	agentMappingHeadlineLabel.Text = snapshot.headline
	agentMappingMetaLabel.Text = snapshot.meta
	agentMappingContextLabel.Text = snapshot.context
	if agentMappingRootsLabel then
		agentMappingRootsLabel.Text = formatMappingList("Roots", snapshot.roots, "No roots mapped yet", 4, snapshot.rootTotal)
	end
	if agentMappingSubsystemsLabel then
		agentMappingSubsystemsLabel.Text = formatMappingList("Subsystems", snapshot.subsystems, "No subsystems inferred yet", 4, snapshot.subsystemTotal)
	end
	if agentMappingScriptsLabel then
		agentMappingScriptsLabel.Text = formatMappingList("Scripts", snapshot.scripts, "No scripts indexed yet", 4, snapshot.scriptTotal)
	end
end
function refreshAgentMappingSection()
	if not agentMappingHeadlineLabel or not agentMappingMetaLabel or not agentMappingContextLabel then
		return nil
	end
	local settings = State.getPluginSettings()
	if not settings.useStructureMapping then
		agentMappingHeadlineLabel.Text = "Mapping disabled"
		agentMappingMetaLabel.Text = "Turn on structure mapping in Settings to expose plugin map data."
		agentMappingContextLabel.Text = "The agent only receives live map details from the plugin when mapping is enabled."
		if agentMappingRootsLabel then
			agentMappingRootsLabel.Text = "Roots: Not available"
		end
		if agentMappingSubsystemsLabel then
			agentMappingSubsystemsLabel.Text = "Subsystems: Not available"
		end
		if agentMappingScriptsLabel then
			agentMappingScriptsLabel.Text = "Scripts: Not available"
		end
		return nil
	end
	applyAgentMappingSnapshot(StructureMap.getAgentMappingSnapshot({
		autoBuild = false,
	}))
end
local function updateDiagnosticsPanel(snapshot)
	diagnosticsLastSnapshot = snapshot
	if diagnosticsBridgeLabel then
		diagnosticsBridgeLabel.Text = `Bridge: {snapshot.bridgeStatus}`
	end
	if diagnosticsPluginLabel then
		diagnosticsPluginLabel.Text = `Plugin: {snapshot.pluginStatus}`
	end
	if diagnosticsMcpLabel then
		diagnosticsMcpLabel.Text = `MCP: {snapshot.mcpStatus}`
	end
	if diagnosticsEndpointSupportLabel then
		diagnosticsEndpointSupportLabel.Text = `Endpoints: {snapshot.endpointSupport}`
	end
	if diagnosticsCacheLabel then
		diagnosticsCacheLabel.Text = `Cache: {snapshot.cacheStatus}`
	end
	if diagnosticsWriteQueueLabel then
		diagnosticsWriteQueueLabel.Text = `Write queue: {snapshot.writeQueueStatus}`
	end
	if diagnosticsErrorLabel then
		diagnosticsErrorLabel.Text = `Last error: {snapshot.lastErrorSummary}`
	end
	if diagnosticsCauseLabel then
		diagnosticsCauseLabel.Text = `Cause: {snapshot.lastErrorCause}`
	end
	if diagnosticsUpdatedLabel then
		diagnosticsUpdatedLabel.Text = `Updated: {snapshot.lastUpdatedAtText}`
	end
end
local function createCompactLabel(parent, textSize, textColor)
	if textSize == nil then
		textSize = 9
	end
	if textColor == nil then
		textColor = C.muted
	end
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 14)
	label.BackgroundTransparency = 1
	label.Text = ""
	label.TextWrapped = true
	label.TextColor3 = textColor
	label.TextSize = textSize
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Parent = parent
	return label
end
function rebuildStructureExplorerList()
	if not explorerResultList then
		return nil
	end
	local list = explorerResultList
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") and child.Name ~= "Layout" then
			child:Destroy()
		end
	end
	local settings = State.getPluginSettings()
	if not settings.useStructureMapping then
		local label = createCompactLabel(list, 9, C.yellow)
		label.Name = "ExplorerDisabled"
		label.Text = "Structure map disabled in Settings."
		return nil
	end
	local _result = explorerSubsystemInput
	if _result ~= nil then
		_result = _result.Text
	end
	local _condition = _result
	if _condition == nil then
		_condition = ""
	end
	local subsystemRaw = _condition
	local _result_1 = explorerScriptTypeInput
	if _result_1 ~= nil then
		_result_1 = _result_1.Text
	end
	local _condition_1 = _result_1
	if _condition_1 == nil then
		_condition_1 = ""
	end
	local scriptTypeRaw = _condition_1
	local _result_2 = explorerPathPrefixInput
	if _result_2 ~= nil then
		_result_2 = _result_2.Text
	end
	local _condition_2 = _result_2
	if _condition_2 == nil then
		_condition_2 = ""
	end
	local pathPrefixRaw = _condition_2
	local _result_3 = explorerSummaryStatusInput
	if _result_3 ~= nil then
		_result_3 = string.lower(_result_3.Text)
	end
	local _condition_3 = _result_3
	if _condition_3 == nil then
		_condition_3 = ""
	end
	local summaryStatusRaw = _condition_3
	local summaryStatus = nil
	if summaryStatusRaw == "missing" or summaryStatusRaw == "fresh" or summaryStatusRaw == "stale" then
		summaryStatus = summaryStatusRaw
	end
	local response = StructureMap.queryStructureMap({
		autoBuild = false,
		mode = "standard",
		filters = {
			limit = 60,
			hasSource = true,
			subsystem = if #subsystemRaw > 0 then subsystemRaw else nil,
			scriptType = if #scriptTypeRaw > 0 then scriptTypeRaw else nil,
			pathPrefix = if #pathPrefixRaw > 0 then pathPrefixRaw else nil,
			summaryStatus = summaryStatus,
		},
	})
	local nodes = response.nodes or {}
	if response.pendingBuild then
		local label = createCompactLabel(list, 9, C.yellow)
		label.Text = "Structure map idle. Use Refresh Structure Map to build this view."
		return nil
	end
	if arrayCount(nodes) == 0 then
		local label = createCompactLabel(list, 9, C.muted)
		label.Text = "No script matches for current filters."
		return nil
	end
	for _, node in nodes do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 30)
		row.BackgroundTransparency = 1
		row.Parent = list
		local top = Instance.new("TextLabel")
		top.Size = UDim2.new(1, 0, 0, 14)
		top.BackgroundTransparency = 1
		local _condition_4 = node.path
		if _condition_4 == nil then
			_condition_4 = "unknown path"
		end
		top.Text = _condition_4
		top.TextColor3 = C.label
		top.TextSize = 9
		top.Font = Enum.Font.GothamMedium
		top.TextXAlignment = Enum.TextXAlignment.Left
		top.TextTruncate = Enum.TextTruncate.AtEnd
		top.Parent = row
		local meta = Instance.new("TextLabel")
		meta.Size = UDim2.new(1, 0, 0, 14)
		meta.Position = UDim2.new(0, 0, 0, 14)
		meta.BackgroundTransparency = 1
		local _condition_5 = node.scriptType
		if _condition_5 == nil then
			_condition_5 = "Script"
		end
		local _condition_6 = node.subsystem
		if _condition_6 == nil then
			_condition_6 = "Unknown"
		end
		local _condition_7 = node.summaryStatus
		if _condition_7 == nil then
			_condition_7 = "missing"
		end
		meta.Text = `{_condition_5} | {_condition_6} | summary {string.upper(_condition_7)}`
		meta.TextColor3 = C.muted
		meta.TextSize = 8
		meta.Font = Enum.Font.GothamMedium
		meta.TextXAlignment = Enum.TextXAlignment.Left
		meta.TextTruncate = Enum.TextTruncate.AtEnd
		meta.Parent = row
	end
end
local function createTabButton(connIndex)
	local conn = State.getConnection(connIndex)
	if not conn then
		return nil
	end
	local isActive = connIndex == State.getActiveTabIndex()
	local tabFrame = Instance.new("Frame")
	tabFrame.Size = UDim2.new(0, 70, 1, -6)
	tabFrame.Position = UDim2.new(0, 0, 0, 3)
	tabFrame.BackgroundColor3 = if isActive then C.surface else C.surfaceAlt
	tabFrame.BackgroundTransparency = if isActive then 0 else 0.25
	tabFrame.BorderSizePixel = 0
	tabFrame.LayoutOrder = connIndex
	tabFrame.Parent = elements.tabBar
	local corner = Instance.new("UICorner")
	corner.CornerRadius = CORNER
	corner.Parent = tabFrame
	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 5, 0, 5)
	dot.Position = UDim2.new(0, 8, 0.5, -2)
	dot.BackgroundColor3 = getStatusDotColor(connIndex)
	dot.BorderSizePixel = 0
	dot.Parent = tabFrame
	local dotCorner = Instance.new("UICorner")
	dotCorner.CornerRadius = UDim.new(1, 0)
	dotCorner.Parent = dot
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -14, 1, 0)
	label.Position = UDim2.new(0, 14, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = tostring(conn.port)
	label.TextColor3 = if isActive then C.label else C.muted
	label.TextSize = 9
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = tabFrame
	local hit = Instance.new("TextButton")
	hit.Size = UDim2.new(1, 0, 1, 0)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Parent = tabFrame
	hit.Activated:Connect(function()
		return switchToTab(connIndex)
	end)
	local _tabButtons = tabButtons
	local _connIndex = connIndex
	local _arg1 = {
		frame = tabFrame,
		label = label,
		dot = dot,
	}
	_tabButtons[_connIndex] = _arg1
end
refreshTabBar = function()
	-- ▼ ReadonlyMap.forEach ▼
	local _callback = function(tb)
		return tb.frame:Destroy()
	end
	for _k, _v in tabButtons do
		_callback(_v, _k, tabButtons)
	end
	-- ▲ ReadonlyMap.forEach ▲
	tabButtons = {}
	do
		local i = 0
		local _shouldIncrement = false
		while true do
			if _shouldIncrement then
				i += 1
			else
				_shouldIncrement = true
			end
			if not (i < arrayCount(State.getConnections())) then
				break
			end
			createTabButton(i)
		end
	end
end
local updateUIState
switchToTab = function(index)
	if index < 0 or index >= arrayCount(State.getConnections()) then
		return nil
	end
	State.setActiveTabIndex(index)
	local conn = State.getActiveConnection()
	elements.urlInput.Text = conn.serverUrl
	-- ▼ ReadonlyMap.forEach ▼
	local _callback = function(tb, i)
		local active = i == index
		tb.frame.BackgroundColor3 = if active then C.surface else C.surfaceAlt
		tb.frame.BackgroundTransparency = if active then 0 else 0.25
		tb.label.TextColor3 = if active then C.label else C.muted
	end
	for _k, _v in tabButtons do
		_callback(_v, _k, tabButtons)
	end
	-- ▲ ReadonlyMap.forEach ▲
	updateUIState()
end
function pushActivity(level, title, detail, options)
	local settings = State.getPluginSettings()
	if not settings.verboseActivity and level == "info" then
		return nil
	end
	local normalized = toActivityOptions(options)
	local payloadText = stringifyPayload(normalized.payload)
	local errorText = if normalized.error ~= nil then tostring(normalized.error) else nil
	local _condition = normalized.path
	if _condition == nil then
		_condition = extractPathFromPayload(normalized.payload)
	end
	local path = _condition
	local category = normalized.category or inferActivityCategory(level, normalized.endpoint)
	local _exp = level
	local _exp_1 = title
	local _exp_2 = detail
	local _object = {
		endpoint = normalized.endpoint,
		path = path,
		payloadText = payloadText,
		errorText = errorText,
	}
	local _left = "groupKey"
	local _condition_1 = normalized.groupKey
	if _condition_1 == nil then
		_condition_1 = path
		if _condition_1 == nil then
			_condition_1 = normalized.endpoint
			if _condition_1 == nil then
				_condition_1 = title
			end
		end
	end
	_object[_left] = _condition_1
	_object.retryContext = normalized.retryContext
	local item = State.addActivity(_exp, category, _exp_1, _exp_2, _object)
	if activeView == "activity" then
		rebuildActivityRows()
	end
end
