          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(script.Parent.Parent.include.RuntimeLib)
local _services = TS.import(script, script.Parent.Parent, "node_modules", "@rbxts", "services")
local CollectionService = _services.CollectionService
local RunService = _services.RunService
local Utils = TS.import(script, script.Parent, "Utils")
local buildAgentMappingSnapshot = TS.import(script, script.Parent, "MappingSummary").buildAgentMappingSnapshot
local shouldSuspendStructureMap = TS.import(script, script.Parent, "PlaytestGuard").shouldSuspendStructureMap
local _binding = Utils
local getInstancePath = _binding.getInstancePath
local getInstanceByPath = _binding.getInstanceByPath
local readScriptSource = _binding.readScriptSource
local initialized = false
local dirty = true
local version = 0
local lastBuiltAt = 0
local lastReason = "startup"
local nodesByPath = {}
local roots = {}
local summaryHashesByPath = {}
local descendantAddedConnection
local descendantRemovingConnection
local function arrayCount(items)
	local count = 0
	for _, _item in items do
		count += 1
	end
	return count
end
local function isStructureMapSuspended()
	local isRunning = false
	local isEdit = false
	TS.try(function()
		isRunning = RunService:IsRunning() == true
	end, function()
		isRunning = false
	end)
	TS.try(function()
		isEdit = RunService:IsEdit() == true
	end, function()
		isEdit = false
	end)
	if isRunning and isEdit then
		isEdit = false
	end
	return shouldSuspendStructureMap({
		isRunning = isRunning,
		isEdit = isEdit,
	})
end
local function buildSuspendedAgentMappingSnapshot()
	return {
		headline = "Structure map suspended during playtest",
		meta = "Playtest runtime data is excluded to keep MCP stable",
		context = "Stop playtest to refresh the edit-time structure map",
		roots = {},
		rootTotal = 0,
		subsystems = {},
		subsystemTotal = 0,
		scripts = {},
		scriptTotal = 0,
	}
end
local function buildPendingAgentMappingSnapshot()
	return {
		headline = "Structure map is idle",
		meta = "No live snapshot built yet",
		context = "Connect and refresh structure map when you need map-aware context",
		roots = {},
		rootTotal = 0,
		subsystems = {},
		subsystemTotal = 0,
		scripts = {},
		scriptTotal = 0,
		pendingBuild = true,
	}
end
local function inferSubsystem(path)
	local cleaned = (string.gsub(path, "^game%.", ""))
	local segments = string.split(cleaned, ".")
	local keywords = { "AI", "Combat", "Inventory", "UI", "Tycoon", "Data", "Player", "Shop", "Quest", "NPC" }
	for _, segment in segments do
		for _1, keyword in keywords do
			local _exp = string.lower(segment)
			local _arg0 = string.lower(keyword)
			if (string.find(_exp, _arg0)) ~= nil then
				return keyword
			end
		end
	end
	return if arrayCount(segments) >= 2 then segments[2] else nil
end
local function hashText(text)
	local hash = 2166136261
	for i = 0, #text - 1 do
		local code = string.byte(text, i + 1)
		hash = bit32.bxor(hash, code)
		hash = bit32.band(hash * 16777619, 0xffffffff)
	end
	return `fnv32:{string.format("%08x", hash)}`
end
local function snapshotNode(instance)
	local path = getInstancePath(instance)
	local _exp = instance:GetChildren()
	-- ▼ ReadonlyArray.map ▼
	local _newValue = table.create(#_exp)
	local _callback = function(child)
		return getInstancePath(child)
	end
	for _k, _v in _exp do
		_newValue[_k] = _callback(_v, _k - 1, _exp)
	end
	-- ▲ ReadonlyArray.map ▲
	local childPaths = _newValue
	local childCount = arrayCount(childPaths)
	local tags = CollectionService:GetTags(instance)
