	local actualEndLine = math.min(totalLineCount, _condition_1)
	if actualStartLine > totalLineCount or actualEndLine < actualStartLine then
		return {
			source = "",
			lineCount = totalLineCount,
			startLine = actualStartLine,
			endLine = actualEndLine,
