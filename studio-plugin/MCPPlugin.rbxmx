          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(script.Parent.Parent.include.RuntimeLib)
local createPluginSessionId = TS.import(script, script.Parent, "PluginSession").createPluginSessionId
local CURRENT_VERSION = "2.3.0"
local MAX_CONNECTIONS = 5
local BASE_PORT = 3002
local MAX_ACTIVITY_ITEMS = 120
local activeTabIndex = 0
local activityCounter = 0
local defaultSettings = {
	parallelAgents = 2,
	useLightModel = false,
	useStructureMapping = true,
	autoPortDiscovery = true,
	verboseActivity = true,
	teamPreset = "balanced",
	reviewerLightMode = true,
	qaLightMode = true,
}
local _object = table.clone(defaultSettings)
setmetatable(_object, nil)
local pluginSettings = _object
local activityItems = {}
local pluginSessionId = createPluginSessionId()
local function arrayCount(items)
	local count = 0
	for _, _item in items do
		count += 1
	end
	return count
end
local function createConnection(port)
	return {
		port = port,
		serverUrl = `http://localhost:{port}`,
		isActive = false,
		pollInterval = 0.5,
		lastPoll = 0,
		consecutiveFailures = 0,
		maxFailuresBeforeError = 50,
		lastSuccessfulConnection = 0,
		currentRetryDelay = 0.5,
		maxRetryDelay = 5,
		retryBackoffMultiplier = 1.2,
		lastHttpOk = false,
		lastMcpConnected = false,
		mcpWaitStartTime = nil,
		isPolling = false,
		heartbeatConnection = nil,
	}
end
local function getServerHost(serverUrl)
	local withoutScheme = (string.gsub(serverUrl, "^https?://", ""))
	local _binding = string.split(withoutScheme, ":")
	local host = _binding[1]
	local _condition = host
	if _condition == nil then
		_condition = "localhost"
	end
	return tostring(_condition)
end
local function replaceConnectionPort(serverUrl, port)
	local _serverUrl = serverUrl
	local _arg1 = `:{port}`
	local replaced, count = string.gsub(_serverUrl, ":%d+$", _arg1)
	if count > 0 then
		return replaced
	end
	return `{serverUrl}:{port}`
end
local connections = { createConnection(BASE_PORT) }
local function addConnection(port)
	if arrayCount(connections) >= MAX_CONNECTIONS then
		return nil
	end
	local lastPort = connections[arrayCount(connections)].port
	local _condition = port
	if _condition == nil then
		_condition = lastPort + 1
	end
	local conn = createConnection(_condition)
